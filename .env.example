KEITARO_URL=https://your-keitaro.example
KEITARO_API_KEY=put-your-key-here

# По умолчанию — SQLite-файл wrapper.db в корне проекта. Для PostgreSQL:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/keitaro_wrapper

CAMPAIGN_PREFIX=test_khristoforov_
# имя домена кампании из вашего Keitaro (Домены)
DEFAULT_DOMAIN=
DEFAULT_GROUP=FORTESTS
DEFAULT_SOURCE=FORTESTS

# Keitaro принимает в поток любой ID оффера, даже если аккаунт не видит его в списке.
# true — разрешить такие ID (помечаются в названии). Нужно, если у аккаунта урезан доступ к офферам.
ALLOW_UNLISTED_OFFERS=false

# С каких Host принимать запросы (JSON-список)
# ALLOWED_HOSTS=["127.0.0.1","localhost"]
